# Скопіюй у .env (у корені репозиторію). Значення підходять лише для локальної розробки.

# PostgreSQL у Docker Compose
POSTGRES_USER=mrochkodent
POSTGRES_PASSWORD=mrochkodent
POSTGRES_DB=mrochkodent
POSTGRES_PORT=5432

# API (NestJS). Порт у DATABASE_URL має збігатися з POSTGRES_PORT.
DATABASE_URL=postgresql://mrochkodent:mrochkodent@localhost:5432/mrochkodent?schema=public
API_PORT=4000
